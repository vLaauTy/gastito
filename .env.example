TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_USER_ID=
ANTHROPIC_API_KEY=

# Para los perfiles postgres (la base real) y prueba (gastito_prueba, en el mismo servidor y con el mismo usuario).
# Ejemplo de DB_URL: jdbc:postgresql://localhost:5432/gastito
DB_URL=
DB_USER=
DB_PASSWORD=
# Opcional: la base del perfil prueba, si no es jdbc:postgresql://localhost:5432/gastito_prueba
#DB_PRUEBA_URL=

# Carpeta de los backups (backup.bat). Conviene una sincronizada con la nube, por ejemplo la de Google Drive para
# escritorio (ejemplo: G:\Mi unidad\Backups\gastito). Sin ella, usa %USERPROFILE%\Backups\gastito (solo en esta
# PC) y avisa.
BACKUP_DIR=

# Servidor de Whisper para los audios. La clave sale de: docker exec whisper whisper_manage --getkey
WHISPER_URL=http://localhost:9000
WHISPER_API_KEY=

# Dashboard en el celular (opcional). Por defecto solo se abre desde esta PC (127.0.0.1).
# Para abrirlo en la red, las dos juntas: sin token, la aplicación no arranca.
#SERVER_ADDRESS=0.0.0.0
#GASTITO_DASHBOARD_TOKEN=
